# ==============================================================================
# BRIDAL MODEL PORTFOLIO - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Security Notice:
# 1. Variables prefixed with 'VITE_' are embedded in plaintext in client bundles.
#    NEVER put secret API keys, private passwords, or tokens in VITE_ variables!
# 2. Private backend secrets (for Phase 2 API) must NOT have the VITE_ prefix.
# ==============================================================================

# Public Client Configuration
VITE_APP_ENV=development
VITE_APP_URL=http://localhost:3000

# Private Backend Secrets (Phase 2 Serverless Functions Only)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# ADMIN_API_SECRET=sec_xxxxxxxxxxxxxxxxxx
